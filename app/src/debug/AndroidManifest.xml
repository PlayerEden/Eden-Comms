<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M3m debug-only Classic inquiry + secure RFCOMM socket experiment.
         Android 12+ Nearby devices permissions are requested on user actions.
         Release gets none of these permissions; legacy location is capped at API 32.
         D1 local-only microphone test adds RECORD_AUDIO to debug APK; no peer persistence or coordinates. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>
    <!-- M3p debug Wi-Fi Direct readiness: no P2P discovery/connection/position reads. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <application>
        <activity
            android:name=".bluetooth.DebugBluetoothDiscoveryActivity"
            android:exported="false"
            android:label="Bluetooth development test"/>
        <activity
            android:name=".wifidirect.DebugWifiDirectPreflightActivity"
            android:exported="false"
            android:label="Wi-Fi Direct device preflight"/>
        <activity
            android:name=".wifidirect.DebugWifiDirectDiscoveryActivity"
            android:exported="false"
            android:label="Wi-Fi Direct discovery development test"/>
        <activity
            android:name=".wifidirect.DebugWifiDirectGroupHostActivity"
            android:exported="false"
            android:label="Wi-Fi Direct local group development test"/>
        <activity
            android:name=".wifidirect.DebugWifiDirectQrActivity"
            android:exported="false"
            android:label="Wi-Fi Direct in-person QR preparation"/>
        <activity
            android:name=".audio.DebugLocalPttActivity"
            android:exported="false"
            android:label="Local microphone and speaker check"/>
    </application>
</manifest>
